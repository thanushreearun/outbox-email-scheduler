# Copy to `.env` in the repository root and fill in the values.
# Both the API and the worker read this one file. Never commit `.env`.

# --- Runtime ---
NODE_ENV=development
PORT=4000
# Optional. Overrides PORT when a tool injects PORT for another process.
# API_PORT=4000
LOG_LEVEL=info
# Browser origin of the web app. In local dev the Vite server also proxies /api,
# so the API is reached through the same origin.
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5173

# --- Data stores (match docker-compose.yml) ---
DATABASE_URL=postgresql://outbox:outbox@localhost:5433/outbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails
# Optional. Redis key prefix for queues and rate-limit counters.
# QUEUE_PREFIX=outbox

# --- Security (required) ---
# Generate each value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SESSION_SECRET must be at least 32 characters; ENCRYPTION_KEY must decode to exactly 32 bytes.
SESSION_SECRET=
ENCRYPTION_KEY=
SESSION_TTL_HOURS=168
# Optional. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false
# Comma-separated Google account emails allowed to open the queue dashboard (/admin/queues).
ADMIN_EMAILS=

# --- Google OAuth (required to sign in) ---
# Authorized redirect URI in Google Cloud Console must equal GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# --- Ethereal SMTP (required to send) ---
# Run `npm run ethereal:create` once and paste the printed user and password here.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_FROM_NAME=Outbox Scheduler

# --- Sending limits ---
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender, across all workers.
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100
MAX_EMAILS_PER_HOUR_GLOBAL=200
EMAIL_MAX_ATTEMPTS=5
EMAIL_BACKOFF_MS=30000
MAX_RECIPIENTS_PER_BATCH=5000
# How often the worker re-checks the outbox, search index and failed Slack messages.
RECONCILE_INTERVAL_MS=60000
# Optional. Length of a rate-limit window (default one hour).
# RATE_LIMIT_WINDOW_MS=3600000

# --- Slack (optional; rate-limit notifications) ---
# Slack requires an HTTPS redirect URL. Locally, expose port 4000 with a tunnel,
# e.g. https://<tunnel-host>/api/slack/oauth/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URL=
SLACK_SIGNING_SECRET=

# --- Attachments ---
UPLOAD_DIR=./uploads
MAX_ATTACHMENT_BYTES=5242880
