// PostgreSQL is the source of truth. Redis (BullMQ) and Elasticsearch hold derived,
// rebuildable state that is reconciled from these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  googleSub String   @unique
  email     String
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions        Session[]
  senders         SenderAccount[]
  batches         EmailBatch[]
  emails          Email[]
  attachments     Attachment[]
  slackConnection SlackConnection?
  rateLimitEvents RateLimitEvent[]
}

// Server-side sessions. Only a SHA-256 hash of the cookie token is stored, so a
// database leak does not yield usable session cookies.
model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum OAuthProvider {
  GOOGLE
  SLACK
}

// Single-use OAuth `state` values (hashed). For Google, the row is also bound to the
// browser through a cookie; for Slack it is bound to the authenticated user.
model OAuthState {
  id                    String        @id @default(uuid())
  stateHash             String        @unique
  provider              OAuthProvider
  userId                String?
  codeVerifierEncrypted String?
  nonce                 String?
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime      @default(now())

  @@index([expiresAt])
}

enum SenderProvider {
  // Credentials come from ETHEREAL_USER / ETHEREAL_PASS; nothing secret is stored in the DB.
  ETHEREAL_ENV
  // A dedicated Ethereal mailbox created deliberately by the user from the settings page.
  ETHEREAL
  // User-supplied SMTP credentials, verified with an SMTP handshake before activation.
  SMTP
}

model SenderAccount {
  id                String         @id @default(uuid())
  userId            String
  email             String
  displayName       String?
  provider          SenderProvider
  // Non-secret pointer to where credentials live: "env" or "db".
  credentialRef     String
  smtpHost          String?
  smtpPort          Int?
  smtpSecure        Boolean        @default(false)
  smtpUser          String?
  smtpPassEncrypted String?
  isActive          Boolean        @default(true)
  verifiedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  batches         EmailBatch[]
  emails          Email[]
  rateLimitEvents RateLimitEvent[]

  @@unique([userId, email])
  @@index([userId, isActive])
}

// One compose submission. Holds the shared body so a 5,000-recipient batch does not
// store 5,000 copies of the same HTML.
model EmailBatch {
  id                String   @id @default(uuid())
  userId            String
  senderAccountId   String
  idempotencyKey    String
  requestHash       String
  subject           String
  bodyHtml          String
  bodyText          String
  // First ~160 chars of the text body for list views (avoids loading full bodies).
  snippet           String
  startAt           DateTime
  delayBetweenMs    Int
  hourlyLimit       Int?
  totalRecipients   Int
  rejectedCount     Int      @default(0)
  duplicateCount    Int      @default(0)
  createdAt         DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderAccount SenderAccount @relation(fields: [senderAccountId], references: [id], onDelete: Restrict)
  emails        Email[]
  attachments   Attachment[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

enum EmailStatus {
  SCHEDULED // persisted; waiting for its time or deferred by a rate limit
  PROCESSING // claimed by a worker; limits being checked; SMTP not yet attempted
  SENDING // SMTP transaction in flight (crash here = ambiguous outcome)
  RETRYING // transient failure; BullMQ will retry with backoff
  SENT // provider accepted the message
  FAILED // permanent failure or attempts exhausted
  CANCELLED // cancelled by the user before processing
}

model Email {
  id                String      @id
  userId            String
  batchId           String
  senderAccountId   String
  recipientEmail    String
  recipientName     String?
  subject           String
  status            EmailStatus @default(SCHEDULED)
  // Requested send time (UTC). Never rewritten by restarts or rate limiting.
  scheduledAt       DateTime
  // Set when a rate limit pushes the send into a later window.
  deferredUntil     DateTime?
  sentAt            DateTime?
  attemptCount      Int         @default(0)
  lastError         String?
  lastErrorCode     String?
  jobId             String      @unique
  idempotencyKey    String      @unique
  // Transactional-outbox marker: NULL until the BullMQ job is known to exist.
  enqueuedAt        DateTime?
  claimToken        String?
  claimedAt         DateTime?
  providerMessageId String?
  previewUrl        String?
  // Optimistic version used as Elasticsearch external version; indexedVersion lags
  // behind version until the search document is updated.
  version           Int         @default(1)
  indexedVersion    Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch         EmailBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  senderAccount SenderAccount @relation(fields: [senderAccountId], references: [id], onDelete: Restrict)
  events        EmailEvent[]

  @@unique([batchId, recipientEmail])
  @@index([userId, status, scheduledAt])
  @@index([userId, status, sentAt])
  @@index([status, enqueuedAt])
  @@index([indexedVersion, version])
}

// Append-only audit trail of status transitions.
model EmailEvent {
  id        String      @id @default(uuid())
  emailId   String
  status    EmailStatus
  message   String?
  createdAt DateTime    @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, createdAt])
}

model Attachment {
  id         String   @id @default(uuid())
  userId     String
  batchId    String?
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String   @unique
  sha256     String
  createdAt  DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch EmailBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([userId, batchId])
}

enum SlackConnectionStatus {
  ACTIVE
  REVOKED
  ERROR
}

model SlackConnection {
  id                  String                @id @default(uuid())
  userId              String                @unique
  teamId              String
  teamName            String?
  authedUserId        String?
  botUserId           String?
  appId               String?
  scopes              String
  // AES-256-GCM ciphertext; never returned to the frontend.
  botTokenEncrypted   String?
  webhookUrlEncrypted String
  channelId           String?
  channelName         String?
  configurationUrl    String?
  status              SlackConnectionStatus @default(ACTIVE)
  lastError           String?
  lastNotifiedAt      DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

enum RateLimitType {
  SENDER
  GLOBAL
  BATCH
}

// One row per (sender, limit, scope, UTC hour window). The unique constraint is the
// Slack notification de-duplication mechanism.
model RateLimitEvent {
  id              String        @id @default(uuid())
  userId          String
  senderAccountId String
  limitType       RateLimitType
  scopeKey        String
  windowStart     DateTime
  limitValue      Int
  resumesAt       DateTime
  notifiedAt      DateTime?
  notifyAttempts  Int           @default(0)
  notifyError     String?
  createdAt       DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderAccount SenderAccount @relation(fields: [senderAccountId], references: [id], onDelete: Cascade)

  @@unique([senderAccountId, limitType, scopeKey, windowStart])
  @@index([notifiedAt, createdAt])
}
