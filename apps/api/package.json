{
  "name": "@outbox/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/with-env.mjs prisma migrate dev",
    "db:deploy": "node scripts/with-env.mjs prisma migrate deploy",
    "db:generate": "prisma generate",
    "ethereal:create": "tsx --env-file-if-exists=../../.env scripts/create-ethereal-account.ts",
    "db:studio": "node scripts/with-env.mjs prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@bull-board/api": "6.21.3",
    "@bull-board/express": "6.21.3",
    "@elastic/elasticsearch": "8.19.2",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "google-auth-library": "10.9.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "multer": "2.4.0",
    "nodemailer": "7.0.13",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "sanitize-html": "2.18.1",
    "swagger-ui-express": "5.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  }
}
